<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CameraUVC.MainPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CameraUVC;assembly=CameraUVC"
    BackgroundColor="Black">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Button Styles -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="WidthRequest" Value="140" />
                <Setter Property="Margin" Value="5" />
            </Style>
            
            <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="#2196F3" />
            </Style>
            
            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="#E91E63" />
            </Style>
            
            <Style x:Key="PhotoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="#4CAF50" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="*,Auto,Auto">
        <!-- Camera Preview Area -->
        <Frame
            Grid.Row="0" 
            Padding="0" 
            Margin="10"
            BackgroundColor="Black" 
            CornerRadius="15"
            HasShadow="True">
            <local:UvcCameraView x:Name="UvcCameraView" BackgroundColor="#1A1A1A" />
        </Frame>

        <!-- Status Label -->
        <Label 
            x:Name="StatusLabel"
            Grid.Row="1"
            Text="Connect a USB camera to get started"
            TextColor="#CCCCCC"
            FontSize="14"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="10,5" />

        <!-- Control Buttons -->
        <StackLayout
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="20,10,20,20"
            Spacing="15">
            
            <Button 
                x:Name="BtnConnect" 
                Text="🔌 Connect"
                Style="{StaticResource ConnectButton}"
                Clicked="BtnConnect_OnClicked" />
            
            <Button 
                x:Name="BtnRecord" 
                Text="🎥 Record"
                Style="{StaticResource RecordButton}"
                IsEnabled="False"
                Opacity="0.5"
                Clicked="BtnRecord_OnClicked" />
            
            <Button 
                x:Name="BtnPhoto" 
                Text="📷 Photo"
                Style="{StaticResource PhotoButton}"
                IsEnabled="False"
                Opacity="0.5"
                Clicked="BtnPhoto_OnClicked" />
                
        </StackLayout>
    </Grid>
</ContentPage>